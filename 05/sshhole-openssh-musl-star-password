y1="84" x2="140" y2="100" class="fill-none stroke-muted-foreground transition-[stroke] duration-300 group-data-[state=on]/part:stroke-primary motion-reduce:transition-none" stroke-width="1.5"/><polygon points="140,108 135.5,99 144.5,99" class="fill-muted-foreground transition-[fill] duration-300 group-data-[state=on]/part:fill-primary motion-reduce:transition-none"/><line x1="420" y1="84" x2="420" y2="100" class="fill-none stroke-muted-foreground transition-[stroke] duration-300 group-data-[state=on]/part:stroke-primary motion-reduce:transition-none" stroke-width="1.5"/><polygon points="420,108 415.5,99 424.5,99" class="fill-muted-foreground transition-[fill] duration-300 group-data-[state=on]/part:fill-primary motion-reduce:transition-none"/><line x1="420" y1="84" x2="464" y2="84" class="fill-none stroke-muted-foreground transition-[stroke] duration-300 group-data-[state=on]/part:stroke-primary motion-reduce:transition-none" stroke-width="1.5"/><text x="12" y="124" font-size="12" class="fill-muted-foreground font-mono">glibc + libxcrypt</text><g data-part="glibc-crypt" data-state="all" class="group/part transition-opacity duration-300 ease-out data-[state=off]:opacity-30 motion-reduce:transition-none"><rect x="12" y="136" width="256" height="52" class="fill-card stroke-border transition-[stroke] duration-300 group-data-[state=on]/part:stroke-primary motion-reduce:transition-none" stroke-width="1.5"/><text x="24" y="157" font-size="13" class="fill-foreground font-mono">4. crypt(password, salt)</text><text x="24" y="175" font-size="11" class="fill-muted-foreground font-mono">returns a real $6$ hash</text></g><line x1="140" y1="188" x2="140" y2="204" class="fill-none stroke-muted-foreground transition-[stroke] duration-300 group-data-[state=on]/part:stroke-primary motion-reduce:transition-none" stroke-width="1.5"/><polygon points="140,212 135.5,203 144.5,203" class="fill-muted-foreground transition-[fill] duration-300 group-data-[state=on]/part:fill-primary motion-red