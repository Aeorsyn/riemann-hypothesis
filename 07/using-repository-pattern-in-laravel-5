<div data-code-frame="true" class="not-prose relative my-8 bg-[var(--p-code-block-color-bg)] py-4 text-sm leading-[1.7] text-syntax-text"><button type="button" class="font-mono text-xs text-syntax-comment transition-colors hover:text-primary absolute top-4 right-3 z-1 bg-[var(--p-code-block-color-bg)] pl-2">copy</button><pre class="overflow-x-auto font-code"><code class="block w-max min-w-full"><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">&#x3C;?</span><span class="hl-fg">php </span><span class="hl-k">namespace</span><span class="hl-f"> App</span><span class="hl-p">\</span><span class="hl-f">Http</span><span class="hl-p">\</span><span class="hl-f">Controllers</span><span class="hl-fg">;</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">use</span><span class="hl-c"> App</span><span class="hl-p">\</span><span class="hl-c">Repositories</span><span class="hl-p">\</span><span class="hl-c">ActorRepository</span><span class="hl-k"> as</span><span class="hl-fg"> Actor;</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">class</span><span class="hl-f"> ActorsController</span><span class="hl-k"> extends</span><span class="hl-f"> Controller</span><span class="hl-fg"> {</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm">    /**</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span