span class="hl-fg">;</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-fg">}</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm">/**</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm"> * Encode an array to a JSON string</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm"> *</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm"> * </span><span class="hl-k">@param</span><span class="hl-cm"> $value</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm"> */</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">public</span><span class="hl-k"> function</span><span class="hl-f"> setSettingsAttribute</span><span class="hl-fg">($value)</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-fg">{</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-c">    $this</span><span class="hl-k">-></span><span class="hl-fg">attributes[</span><span class="hl-se">'settings'</span><span class="hl-fg">] </span><span class="hl-k">=</span><span class="hl-f"> json_encode</span><span class="hl-p">(</span><span class="hl-f">$value</span><span class="hl-p">)</span><span class="hl-fg">;</span></span></span></span><span class="flex min-h-[1.7em] pr