<h2 id="icinga-web">Icinga Web</h2>
<div data-code-frame="true" class="not-prose relative my-8 bg-[var(--p-code-block-color-bg)] py-4 text-sm leading-[1.7] text-syntax-text"><div class="mb-3 flex items-baseline gap-4 border-b border-dashed pr-3 pb-3 pl-3 font-mono text-xs"><span class="min-w-0 truncate text-syntax-text">terminal</span><span class="text-syntax-comment max-sm:hidden">1<!-- --> <!-- -->line</span><button type="button" class="font-mono text-xs text-syntax-comment transition-colors hover:text-primary ml-auto">copy</button></div><pre class="overflow-x-auto font-code"><code class="block w-max min-w-full"><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-f">apt-get</span><span class="hl-s"> install</span><span class="hl-s"> icinga-web</span><span class="hl-s"> -y</span></span></span></span></code></pre></div>
