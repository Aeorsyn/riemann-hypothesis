ass="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm">     *</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm">     * </span><span class="hl-k">@var</span><span class="hl-k"> array</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-cm">     */</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">    protected</span><span class="hl-fg"> $fillable </span><span class="hl-k">=</span><span class="hl-fg"> [</span><span class="hl-se">'username'</span><span class="hl-p">,</span><span class="hl-se"> 'email'</span><span class="hl-p">,</span><span class="hl-se"> 'first_name'</span><span class="hl-p">,</span><span class="hl-se"> 'last_name'</span><span class="hl-fg">];</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">    public</span><span class="hl-k"> function</span><span class="hl-f"> stores</span><span class="hl-fg">() {</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-k">        return</span><span class="hl-c"> $this</span><span class="hl-k">-></span><span class="hl-f">hasMany</span><span class="hl-p">(</span><span class="hl-se">'App\\Store'</span><span class="hl-p">)</span><span class="hl-fg">;</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-fg">    }</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-fg">}</span></span></span></span></code></pre></div>
