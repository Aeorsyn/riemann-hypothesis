.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-se">        'password'</span><span class="hl-k">          =></span><span class="hl-c"> Hash</span><span class="hl-k">::</span><span class="hl-f">make</span><span class="hl-p">(</span><span class="hl-c">Input</span><span class="hl-k">::</span><span class="hl-f">get</span><span class="hl-p">(</span><span class="hl-se">'password'</span><span class="hl-p">)),</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-se">        'password_confirm'</span><span class="hl-k">  =></span><span class="hl-c"> Hash</span><span class="hl-k">::</span><span class="hl-f">make</span><span class="hl-p">(</span><span class="hl-c">Input</span><span class="hl-k">::</span><span class="hl-f">get</span><span class="hl-p">(</span><span class="hl-se">'password'</span><span class="hl-p">))</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-fg">    ];</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-fg">    $rules </span><span class="hl-k">=</span><span class="hl-fg"> [</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-se">        'first_name'</span><span class="hl-k">        =></span><span class="hl-se"> 'required|alpha|max:100'</span><span class="hl-p">,</span></span></span></span><span class="flex min-h-[1.7em] pr-4"><span class="whitespace-pre pl-3"><span class="line"><span class="hl-se">        'last_name'</span><span class="hl-k">         =></span><span class="hl-se"> 'required|alpha|max:100'</span><span class="hl-p">,</span></span></span></span><span class="flex min-h-[1.7em] 